[submodule "lib/FreeRTOS-Kernel"]
	path = lib/FreeRTOS-Kernel
	url = git@github.com:FreeRTOS/FreeRTOS-Kernel.git
[submodule "lib/ni-midi2"]
	path = lib/ni-midi2
	url = git@github.com:midi2-dev/ni-midi2.git
[submodule "lib/AM_MIDI2.0Lib"]
	path = lib/AM_MIDI2.0Lib
	url = git@github.com:midi2-dev/AM_MIDI2.0Lib.git
# NOTE (apple-gtb-repro branch only): lib/tusb_ump points at the Muse-Kinetics fork, not
# midi2-dev, so this branch resolves its pinned submodule commit (two driver fixes -- see
# apple_gtb_repro/MANIFEST.md section 10) without waiting on the upstream PR to merge. Do not
# carry this override to any branch intended to merge back upstream.
[submodule "lib/tusb_ump"]
	path = lib/tusb_ump
	url = git@github.com:Muse-Kinetics/tusb_ump.git
[submodule "lib/CMSIS_5"]
	path = lib/CMSIS_5
	url = git@github.com:ARM-software/CMSIS_5.git
[submodule "lib/NetworkMIDI2"]
	path = lib/NetworkMIDI2
	url = git@github.com:midi2-dev/NetworkMIDI2.git
[submodule "lib/RP2040-HAT-LWIP-C"]
	path = lib/RP2040-HAT-LWIP-C
	url = git@github.com:Wiznet/RP2040-HAT-LWIP-C.git
